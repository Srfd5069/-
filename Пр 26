#include <iostream>
#include <string>
#include <cstdlib>
#include <ctime>
#include <windows.h>

using namespace std;


struct PlayerSettings {
    string name;
    char symbol;
    int colorCode;
    int wins = 0;
    int losses = 0;
    int draws = 0;
    double score = 0.0;

    void updateScore() {

        score = (wins * 5.0) + (losses * -6.0) + (draws * -1.2);
    }
};


int currentTheme = 1;
PlayerSettings p1 = { "Игрок 1", 'X', 11 };
PlayerSettings p2 = { "Игрок 2", 'O', 12 };
PlayerSettings comp = { "Компьютер", 'O', 14 };


void setColor(int code) {
    HANDLE hConsole = GetStdHandle(STD_OUTPUT_HANDLE);
    SetConsoleTextAttribute(hConsole, code);
}

int getThemeColor() {

    if (currentTheme == 1) {
        return 7;
    }
    else if (currentTheme == 2) {
        return 10;
    }
    else {
        return 13;
    }
}

void clearScreen() {
    system("cls");
}
void drawGameBoard(char board[9], string infoText, int infoColor) {
    int tc = getThemeColor();
    setColor(tc); cout << "+ | Крестики нолики        + | Информация\n";
    cout << "     " << board[0] << " | " << board[1] << " | " << board[2] << "             ";
    if (!infoText.empty()) {
        setColor(infoColor); cout << infoText;
    }
    cout << "\n";

    setColor(tc); cout << "    ---+---+---\n";
    cout << "     " << board[3] << " | " << board[4] << " | " << board[5] << "\n";
    setColor(tc); cout << "    ---+---+---\n";
    cout << "     " << board[6] << " | " << board[7] << " | " << board[8] << "\n\n";
}
bool checkWin(char board[9], char s) {
    
    if (board[0] == s && board[1] == s && board[2] == s) return true;
    if (board[3] == s && board[4] == s && board[5] == s) return true;
    if (board[6] == s && board[7] == s && board[8] == s) return true;

    if (board[0] == s && board[3] == s && board[6] == s) return true;
    if (board[1] == s && board[4] == s && board[7] == s) return true;
    if (board[2] == s && board[6] == s && board[8] == s) return true;

    if (board[0] == s && board[4] == s && board[8] == s) return true;
    if (board[2] == s && board[4] == s && board[6] == s) return true;

    return false;
}
void showStatistics() {
    while (true) {
        clearScreen();
        p1.updateScore();
        p2.updateScore();
        comp.updateScore();

        setColor(getThemeColor());
        cout << "+ | Статистика\n\n";
        cout << "\t\tW\tL\tD  |  Очки\n";
        cout << "1 | " << p1.name << "\t" << p1.wins << "\t" << p1.losses << "\t" << p1.draws << "  |  " << p1.score << "\n";
        cout << "2 | " << p2.name << "\t" << p2.wins << "\t" << p2.losses << "\t" << p2.draws << "  |  " << p2.score << "\n";
        cout << "3 | " << comp.name << "\t" << comp.wins << "\t" << comp.losses << "\t" << comp.draws << "  |  " << comp.score << "\n\n";
        cout << "0 | Назад\n\n> | Ввод: ";

        int choice;
        cin >> choice;
        if (choice == 0) return;
    }
}

void configurePlayer(PlayerSettings& player, bool isBot) {
    while (true) {
        clearScreen();
        setColor(getThemeColor());
        cout << "+ | Настройки игрока [" << player.name << "]\n\n";
        if (!isBot) {
            cout << "1 | Ник\t: " << player.name << "\n";
        }
        cout << "2 | Фигура\t: " << player.symbol << "\n";
        cout << "3 | Цвет (код)\t: " << player.colorCode << "\n";
        cout << "0 | Назад\n\n> | Ввод: ";

        int choice;
        cin >> choice;
        if (choice == 0) return;

        if (choice == 1 && !isBot) {
            cout << "Введите ник: ";
            cin >> player.name;
        }
        else if (choice == 2) {
            cout << "Введите символ: ";
            cin >> player.symbol;
        }
        else if (choice == 3) {
            cout << "Введите код цвета (1-15): ";
            cin >> player.colorCode;
        }
    }
}

void showSettings() {
    while (true) {
        clearScreen();
        setColor(getThemeColor());
        cout << "+ | Настройки\n\n";
        cout << "1 | Игрок 1 (" << p1.name << ")\n";
        cout << "2 | Игрок 2 (" << p2.name << ")\n";
        cout << "3 | Компьютер\n";
        cout << "4 | Тема интерфейса (Текущая: " << currentTheme << ")\n";
        cout << "0 | Назад\n\n> | Ввод: ";

        int choice;
        cin >> choice;
        if (choice == 0) return;

        if (choice == 1) configurePlayer(p1, false);
        else if (choice == 2) configurePlayer(p2, false);
        else if (choice == 3) configurePlayer(comp, true);
        else if (choice == 4) {
            clearScreen();
            cout << "Выберите тему (1 - Белая, 2 - Зеленая, 3 - Фиолетовая): ";
            cin >> currentTheme;
        }
    }
}
void playGame(bool vsBot) {
    char board[9] = { '1','2','3','4','5','6','7','8','9' };
    int turn = 1;
    PlayerSettings& opponent = vsBot ? comp : p2;
    string lastMoveInfo = "";
    int lastMoveColor = 7;
    for (int moves = 0; moves < 9; moves++) {
        clearScreen();
        drawGameBoard(board, lastMoveInfo, lastMoveColor);

        int choice;
        char currentSymbol;
        string currentPlayerName;
        int currentColor;
        if (turn == 1) {
            currentSymbol = p1.symbol;
            currentPlayerName = p1.name;
            currentColor = p1.colorCode;
        }
        else {
            currentSymbol = opponent.symbol;
            currentPlayerName = opponent.name;
            currentColor = opponent.colorCode;
        }

        setColor(getThemeColor());
        cout << "> | Ходит " << currentPlayerName << " : ";

        if (turn == 2 && vsBot) {
            int botChoice;
            do {
                botChoice = rand() % 9;
            } while (board[botChoice] == p1.symbol || board[botChoice] == comp.symbol);

            board[botChoice] = comp.symbol;
            lastMoveInfo = "+ | " + comp.name + " ход на клетку: " + to_string(botChoice + 1);
            lastMoveColor = comp.colorCode;
            Sleep(600);
        }
        else {
            cin >> choice;
            if (choice == 0) return;

            if (choice < 1 || choice > 9 || board[choice - 1] == p1.symbol || board[choice - 1] == p2.symbol || board[choice - 1] == comp.symbol) {
                moves--; 
                continue;
            }

            board[choice - 1] = currentSymbol;
            lastMoveInfo = "+ | " + currentPlayerName + " ход на клетку: " + to_string(choice);
            lastMoveColor = currentColor;
        }

        if (checkWin(board, currentSymbol)) {
            clearScreen();
            drawGameBoard(board, lastMoveInfo, lastMoveColor);
            setColor(currentColor); cout << "Победил " << currentPlayerName << "!\n\n";

            if (turn == 1) {
                p1.wins++; opponent.losses++;
            }
            else {
                opponent.wins++; p1.losses++;
            }
            setColor(getThemeColor()); cout << "Нажмите Enter..."; cin.ignore(); cin.get();
            return;
        }

        if (turn == 1) turn = 2;
        else turn = 1;
    }

    clearScreen();
    drawGameBoard(board, lastMoveInfo, lastMoveColor);
    setColor(getThemeColor()); cout << "Ничья!\n\n";
    p1.draws++; opponent.draws++;
    cout << "Нажмите Enter..."; cin.ignore(); cin.get();
}

void chooseGameMode() {
    while (true) {
        clearScreen();
        setColor(getThemeColor());
        cout << "+ | Крестики нолики\n\n1 | Одиночная игра\n2 | Два игрока\n\n0 | Назад\n\n> | Ввод: ";
        int choice;
        cin >> choice;
        if (choice == 0) return;
        if (choice == 1) { playGame(true); return; }
        if (choice == 2) { playGame(false); return; }
    }
}

int main() {
    SetConsoleCP(1251);
    SetConsoleOutputCP(1251);
    srand(static_cast<unsigned int>(time(0)));

    while (true) {
        clearScreen();
        setColor(getThemeColor());
        cout << "+ | Меню\n\n1 | Начать игру\n2 | Статистика\n3 | Настройки\n4 | Выйти\n\n> | Ввод: ";

        int choice;
        cin >> choice;
        switch (choice) {
        case 1: chooseGameMode(); break;
        case 2: showStatistics(); break;
        case 3: showSettings(); break;
        case 4: clearScreen(); cout << "До свидания!\n"; return 0;
        default: break;
        }
    }
}
